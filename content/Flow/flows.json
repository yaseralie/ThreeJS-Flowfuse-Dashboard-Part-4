    {
        "id": "57f5639a99dd2395",
        "type": "ui-template",
        "z": "168ef48b19c5ec43",
        "g": "ea1b052ff236cd42",
        "group": "114f08da44e3c00f",
        "page": "",
        "ui": "",
        "name": "Duck Simple",
        "order": 5,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <div ref=\"container\" style=\"\n            width:100%;\n            height:100%;\n            min-height:400px;\n        \"></div>\n</template>\n\n<script>\nexport default {\n    data() {\n        return {\n            duck: null,\n            duckMesh: null,\n            originalColor: null\n        }\n    },\n\n    watch: {\n        msg() {          \n            if (!this.duckMesh) return          \n            if (!this.msg?.payload) return\n            \n            if (this.msg.payload ===\"reset\") {           \n                this.duckMesh.material.color.copy(this.originalColor)          \n                return         \n            }            \n            this.duckMesh.material.color.set(this.msg.payload)        \n        }\n    },\n\n    async mounted() {\n        const THREE = await import('https://esm.sh/three@0.179.1')\n        const { OrbitControls } = await import('https://esm.sh/three@0.179.1/examples/jsm/controls/OrbitControls')\n        const { GLTFLoader } = await import('https://esm.sh/three@0.179.1/examples/jsm/loaders/GLTFLoader')\n\n        const container = this.$refs.container\n\n        // Scene\n        const scene = new THREE.Scene()\n        scene.background = new THREE.Color(0xf5f5f5)\n\n        // Camera\n        const camera =\n            new THREE.PerspectiveCamera(\n                75,\n                container.clientWidth /\n                container.clientHeight,\n                0.1,\n                1000\n            )\n        camera.position.set(5,5,5)\n\n        // Renderer\n        const renderer =\n            new THREE.WebGLRenderer({\n                antialias:true\n            })\n\n        renderer.setSize(\n            container.clientWidth,\n            container.clientHeight\n        )\n\n        container.appendChild(renderer.domElement)\n\n        // Orbit\n        const controls =\n            new OrbitControls(\n                camera,\n                renderer.domElement\n            )\n\n        controls.enableDamping = true\n\n        // Light\n        scene.add(\n            new THREE.AmbientLight(\n                0xffffff,\n                2\n            )\n        )\n\n        const light =\n            new THREE.DirectionalLight(\n                0xffffff,\n                3\n            )\n\n        light.position.set(5,10,5)\n        scene.add(light)\n\n        // Grid\n        scene.add(\n            new THREE.GridHelper(\n                20,\n                20\n            )\n        )\n\n        // Axis\n        scene.add(new THREE.AxesHelper(5))\n\n        // Load GLB\n        const loader = new GLTFLoader()\n\n        loader.load(\n            \"/models/Duck.glb\",\n            (gltf) => {\n                const duck = gltf.scene\n\n                // Start to Traverse Object\n                let duckMesh = null\n                duck.traverse(\n                    (obj) => {\n                        if (obj.isMesh) {\n                            duckMesh = obj\n                            console.log(\"FOUND MESH:\",obj.name)\n                        }\n                    }\n                )\n\n                this.duckMesh = duckMesh\n                this.originalColor = duckMesh.material.color.clone()\n\n                duck.scale.set(2,2,2)\n                duck.position.set(0,0,0)\n\n                duck.userData.type = \"duck\"\n                scene.add(duck)\n                this.duck = duck\n            },\n\n            undefined,\n            (err) => {console.error(err)}\n        )\n\n        // Animation\n        const animate = () => {\n            requestAnimationFrame(\n                animate\n            )\n\n            controls.update()\n\n            renderer.render(\n                scene,\n                camera\n            )\n\n        }\n\n        animate()\n\n    }\n\n}\n</script>",
