        "format": "<template>\n    <div ref=\"container\" style=\"\n            width:100%;\n            height:100%;\n            min-height:500px;\n        \"></div>\n</template>\n\n<script>\nexport default {\n    data() {\n        return {\n            openValve: false,\n            resetGlass: false\n        }\n    },\n\n    watch: {\n        msg() {          \n            if (typeof this.msg?.open === \"boolean\") {\n                this.openValve = this.msg.open\n            }\n            if (this.msg?.payload === \"reset\") {\n                this.resetGlass = true\n            }\n        }\n    },\n\n    async mounted() {\n        const THREE = await import('https://esm.sh/three@0.179.1')\n        const { OrbitControls } = await import('https://esm.sh/three@0.179.1/examples/jsm/controls/OrbitControls')\n        const { GLTFLoader } = await import('https://esm.sh/three@0.179.1/examples/jsm/loaders/GLTFLoader')\n\n        const container = this.$refs.container\n\n        // Scene\n        const scene = new THREE.Scene()\n        scene.background = new THREE.Color(0xf5f5f5)\n\n        // Camera\n        const camera =\n            new THREE.PerspectiveCamera(\n                90,\n                container.clientWidth /\n                container.clientHeight,\n                0.1,\n                1000\n            )\n        camera.position.set(0,7,4)\n\n        // Renderer\n        const renderer =\n            new THREE.WebGLRenderer({\n                antialias:true\n            })\n\n        renderer.setSize(\n            container.clientWidth,\n            container.clientHeight\n        )\n\n        container.appendChild(renderer.domElement)\n\n        // Orbit\n        const controls =\n            new OrbitControls(\n                camera,\n                renderer.domElement\n            )\n\n        controls.enableDamping = true\n\n        // Light\n        scene.add(\n            new THREE.AmbientLight(\n                0xffffff,\n                2\n            )\n        )\n\n        const light =\n            new THREE.DirectionalLight(\n                0xffffff,\n                2\n            )\n\n        light.position.set(5,10,5)\n        scene.add(light)\n\n        // Grid\n        scene.add(\n            new THREE.GridHelper(\n                10,\n                10\n            )\n        )\n\n        // Load GLB\n        const loader = new GLTFLoader()\n        loader.load(\n        \"/models/water_dispenser.glb\",\n        (gltf) => {\n            const water_dispenser = gltf.scene\n\n            water_dispenser.traverse((obj) => {\n                console.log(obj.name)\n\n                if (obj.name === \"Cold_water_dispenser_1\") {\n                    this.coldNozzle = obj\n                    console.log(\n                        \"NOZZLE\",\n                        obj.getWorldPosition(\n                        new THREE.Vector3()\n                        )\n                    )\n                }\n\n            })\n\n            water_dispenser.scale.set(1,1,1)\n            water_dispenser.position.set(0,0,0)\n\n            scene.add(water_dispenser)\n            this.water_dispenser = water_dispenser\n\n        },\n        undefined,\n        (err) => console.error(err)\n        )\n\n        // Create water flow from nozzle==============================\n        const waterGeometry = new THREE.CylinderGeometry(\n            0.011,\n            0.011,\n            0.7,\n            16\n        )\n\n        const waterMaterial = new THREE.MeshPhysicalMaterial({\n            color: 0x66ccff,\n            transparent: true,\n            opacity: 0.7\n        })\n\n        this.waterStream = new THREE.Mesh(\n            waterGeometry,\n            waterMaterial\n        )\n\n        this.waterStream.position.set(\n            0.192,\n            2.35,\n            0.570\n        )\n\n        scene.add(this.waterStream)\n        // start from 0\n        this.waterStream.scale.y = 0\n\n        // Nozzle position:\n        this.waterTopY = 2.67\n        this.waterHeight = 0.7\n\n        // Create water in glass==============================\n        const waterGlassGeometry = new THREE.CylinderGeometry(\n            0.090,\n            0.049,\n            0.53,\n            16\n        )\n        \n        const waterGlassMaterial = new THREE.MeshPhysicalMaterial({\n            color: 0x66ccff,\n            transparent: true,\n            opacity: 0.7\n        })\n        \n        this.waterGlass = new THREE.Mesh(\n            waterGlassGeometry,\n            waterGlassMaterial\n        )\n        \n        this.waterGlass.position.set(\n            0.192,\n            2.153,\n            0.58\n        )\n        \n        scene.add(this.waterGlass)\n        // start empty\n        this.waterGlass.scale.y = 0\n        \n        // bottom position of water in glass\n        this.waterGlassBottomY = 1.89\n        \n        // max water height\n        this.waterGlassHeight = 0.53\n\n        // Animation\n        const animate = () => {\n            requestAnimationFrame(\n                animate\n            )\n\n            controls.update()\n\n            // Open / Close water\n            if (this.openValve) {\n                if (this.waterStream.scale.y < 1) { \n                    this.waterStream.scale.y +=0.03 } \n            } \n            else { \n                if (this.waterStream.scale.y> 0) {\n                    this.waterStream.scale.y -= 0.07\n                }\n            }\n\n            // Limit\n            this.waterStream.scale.y = Math.max(0,Math.min(1,this.waterStream.scale.y))\n            // Keep top attached to nozzle\n            const currentHeight = this.waterHeight * this.waterStream.scale.y\n\n            this.waterStream.position.y = this.waterTopY - currentHeight / 2\n\n            // Small wave effect\n            if (this.waterStream.scale.y > 0) {\n                const t = Date.now() * 0.01\n                this.waterStream.scale.x = 1 + Math.sin(t) * 0.08\n                this.waterStream.scale.z = 1 + Math.cos(t) * 0.08\n            }\n\n            // Water level in glass\n            // Reset glass\n            if (this.resetGlass) {           \n                this.waterGlass.scale.y = 0               \n                this.waterGlass.position.y =\n                this.waterGlassBottomY              \n                this.resetGlass = false          \n            }\n\n            if (this.openValve) {\n                if (this.waterGlass.scale.y < 1) { \n                    this.waterGlass.scale.y +=0.0017 \n                } \n            } \n                \n            this.waterGlass.scale.y=Math.max( 0, Math.min(1,\n                this.waterGlass.scale.y) ) \n            \n            const glassHeight=\n                this.waterGlassHeight * this.waterGlass.scale.y\n            \n            this.waterGlass.position.y=this.waterGlassBottomY + glassHeight / 2 \n            \n            if (this.waterGlass.scale.y> 0) {\n                const t = Date.now() * 0.001\n                this.waterGlass.scale.x = 1 + Math.sin(t) * 0.01\n                this.waterGlass.scale.z = 1 + Math.cos(t) * 0.01\n            } \n            else {\n                this.waterGlass.scale.x = 1\n                this.waterGlass.scale.z = 1\n            }\n                \n            renderer.render(\n                scene,\n                camera\n            )\n\n        }\n\n        animate()\n\n    }\n\n}\n</script>",
