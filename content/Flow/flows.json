        "name": "Table Fan",
        "order": 4,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <div ref=\"container\" style=\"\n            width:100%;\n            height:100%;\n            min-height:500px;\n        \"></div>\n</template>\n\n<script>\nexport default {\n    data() {\n        return {\n            table_fan: null,\n            motor: null,\n            BladePivot: null,\n            \n            fanEnable: false,\n            swingEnable: false,\n            swingDirection: 1\n        }\n    },\n\n    watch: {\n        msg() {          \n            if (typeof this.msg?.swing === \"boolean\") {\n                this.swingEnable = this.msg.swing\n            }\n            if (typeof this.msg?.control === \"boolean\") {\n                this.fanEnable = this.msg.control\n            }\n        }\n    },\n\n    async mounted() {\n        const THREE = await import('https://esm.sh/three@0.179.1')\n        const { OrbitControls } = await import('https://esm.sh/three@0.179.1/examples/jsm/controls/OrbitControls')\n        const { GLTFLoader } = await import('https://esm.sh/three@0.179.1/examples/jsm/loaders/GLTFLoader')\n\n        const container = this.$refs.container\n\n        // Scene\n        const scene = new THREE.Scene()\n        scene.background = new THREE.Color(0xf5f5f5)\n\n        // Camera\n        const camera =\n            new THREE.PerspectiveCamera(\n                90,\n                container.clientWidth /\n                container.clientHeight,\n                0.1,\n                1000\n            )\n        camera.position.set(0,10,9)\n\n        // Renderer\n        const renderer =\n            new THREE.WebGLRenderer({\n                antialias:true\n            })\n\n        renderer.setSize(\n            container.clientWidth,\n            container.clientHeight\n        )\n\n        container.appendChild(renderer.domElement)\n\n        // Orbit\n        const controls =\n            new OrbitControls(\n                camera,\n                renderer.domElement\n            )\n\n        controls.enableDamping = true\n\n        // Light\n        scene.add(\n            new THREE.AmbientLight(\n                0xffffff,\n                2\n            )\n        )\n\n        const light =\n            new THREE.DirectionalLight(\n                0xffffff,\n                3\n            )\n\n        light.position.set(5,10,5)\n        scene.add(light)\n\n        // Grid\n        scene.add(\n            new THREE.GridHelper(\n                20,\n                20\n            )\n        )\n\n        // Load GLB\n        const loader = new GLTFLoader()\n\n        loader.load(\n            \"/models/table_fan.glb\",\n            (gltf) => {\n                const table_fan = gltf.scene\n                    table_fan.traverse(\n                        (obj) => {\n                            if (obj.name === \"Motor\") {\n                                this.motor = obj\n                                console.log(\"FOUND MOTOR\",obj)\n                            }\n\n                            if (obj.name === \"BladePivot\") {\n                                this.BladePivot = obj\n                                console.log(\"FOUND BLADE SUPPORT\", obj)\n                            }\n\n                        }\n                    )\n                \n                table_fan.scale.set(0.02,0.02,0.02)\n                table_fan.position.set(0,0,0)\n\n                scene.add(table_fan)\n                this.table_fan = table_fan\n            },\n\n            undefined,\n            (err) => {console.error(err)}\n        )\n\n        // Animation\n        const animate = () => {\n            requestAnimationFrame(\n                animate\n            )\n\n            controls.update()\n            if ( this.fanEnable && this.BladePivot) {\n                this.BladePivot.rotation.z +=0.2\n            }\n\n            if ( this.swingEnable && this.motor) {\n                this.motor.rotation.z += 0.01 * this.swingDirection\n\n                if (this.motor.rotation.z > Math.PI / 4) {\n                    this.swingDirection = -1\n                    }\n\n                if (this.motor.rotation.z < -Math.PI / 4 ) { \n                    this.swingDirection=1 \n                    } \n            }\n\n            renderer.render(\n                scene,\n                camera\n            )\n\n        }\n\n        animate()\n\n    }\n\n}\n</script>",
